# CUDA translation units (sm_89) — device objects for the GPU engine targets.
%.o: %.cu
	$(NVCC) $(NVCCFLAGS) -c $< -o $@

# Probe: which GPU objects compile on Windows today (make -k gpu-probe).
gpu-probe: src/gpu_gemma4_forward.o src/gpu_quant_matmul.o src/gpu_quant_matmul_row_major.o src/flash_attn_q4_0_opt.o src/flash_attn_q4_0_prefill_opt.o src/gpu_gemma4.o
	@echo gpu-probe-complete

# GPU gemma4 engine: nvcc device objects + MinGW host code (extern "C" ABI).
G4_GPU_OBJ = src/wubu_gemma4_model.o src/gguf_reader.o src/quantized_matmul.o \
             src/quantized_dot_generic.o src/gpu_gemma4_forward.o \
             src/gpu_quant_matmul.o src/gpu_quant_matmul_row_major.o \
             src/flash_attn_q4_0_opt.o src/flash_attn_q4_0_prefill_opt.o

# GNU make on this host cannot spawn a shell for recipes containing quotes, so the
# CUDA lib path is spelled in 8.3 form and nothing else in the recipe is quoted.
CUDA_LIB83 = C:/PROGRA~1/NVIDIA~2/CUDA/v13.5/lib/x64

gen_text_gemma4_gpu: tools/gen_text_gemma4.c $(G4_GPU_OBJ)
	$(CXX) $(CFLAGS) $(CUDA_INC) -DGPU_SUPPORT -o $@ tools/gen_text_gemma4.c $(G4_GPU_OBJ) -L$(CUDA_LIB83) -lcudart -lcublas -fopenmp -lm -lstdc++

# EG-111: fused IQ2_S/IQ3_S x Q8_K dot products.
test_eg111_iq_fused: tools/test_eg111_iq_fused.c src/wubu_vecdot_iq.c src/gguf_reader.c src/quantized_dot_generic.c src/wubu_win.c
