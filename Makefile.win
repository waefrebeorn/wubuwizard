test_eg11_grammar: tools/test_eg11_grammar.c src/wubu_grammar_fsm.c
	$(CC) $(CFLAGS) -o $@ $^ -lws2_32 -ladvapi32 -lkernel32 -luser32 -fopenmp -lm -static

