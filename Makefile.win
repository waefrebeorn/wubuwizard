test_eg05_neuron: tools/test_eg05_neuron.c src/wubu_neuron_cluster.c
	$(CC) $(CFLAGS) -o $@ $^ -lws2_32 -ladvapi32 -lkernel32 -luser32 -fopenmp -lm -static

